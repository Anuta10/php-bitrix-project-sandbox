FROM php:8.4-apache

WORKDIR /var/www/html

COPY . /var/www/html
COPY docker/apache-timeweb.conf /etc/apache2/sites-available/000-default.conf

RUN a2enmod headers rewrite \
    && sed -ri 's!Listen 80!Listen 8080!g' /etc/apache2/ports.conf \
    && mkdir -p /var/www/html/storage \
    && chown -R www-data:www-data /var/www/html/storage

EXPOSE 8080

# Timeweb умеет проверять состояние контейнера. Проверяем тот же маршрут,
# который используется для внешнего health check приложения.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD php -r 'exit(@file_get_contents("http://127.0.0.1:8080/health") === false ? 1 : 0);'

CMD ["apache2-foreground"]
